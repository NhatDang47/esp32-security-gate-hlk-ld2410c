    {
        "id": "2aaf05413f0dd9c7",
        "type": "function",
        "z": "f2341ea2c16839d8",
        "name": "Format for Chart Node",
        "func": "var rows = msg.payload;\nvar series = [\"Lượt Vào\", \"Lượt Ra\"];\nvar data = [[], []];\nvar labels = [];\n\nfor(var i=0; i<24; i++) {\n  var h = (i<10?'0':'') + i;\n  labels.push(h + ':00');\n  data[0].push(0);\n  data[1].push(0);\n}\n\nif(rows && rows.length > 0) {\n  rows.forEach(function(r) {\n    var hourIdx = parseInt(r.h, 10);\n    data[0][hourIdx] = r.vao || 0;\n    data[1][hourIdx] = r.ra || 0;\n  });\n}\n\nmsg.payload = [{\n  series: series,\n  data: data,\n  labels: labels\n}];\nreturn msg;\n",
