        "func": "var p = msg.payload;\nif (!p) return null;\n\nvar action = p.action || 'TRONG';\nvar distance = p.distance !== undefined ? p.distance : 0;\nvar energy = p.energy !== undefined ? p.energy : 0;\nvar cin = p.count_in !== undefined ? p.count_in : 0;\nvar cout = p.count_out !== undefined ? p.count_out : 0;\n\nvar overview = { action: action, distance: distance };\nvar counters = { cin: cin, cout: cout };\n\nreturn [\n  { payload: overview },\n  { payload: distance },\n  { payload: energy },\n  { payload: counters }\n];\n",
