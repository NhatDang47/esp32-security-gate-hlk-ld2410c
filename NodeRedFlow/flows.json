        "z": "f2341ea2c16839d8",
        "name": "Format Weekly Stats",
        "func": "var rows = msg.payload;\nvar totalVaoTuan = 0;\nvar totalRaTuan = 0;\n\nvar totalVaoHomNay = 0;\nvar totalRaHomNay = 0;\n\nvar maxDay = null;\nvar maxTotal = -1;\nvar minDay = null;\nvar minTotal = 9999999;\n\nvar tzOffset = (new Date()).getTimezoneOffset() * 60000;\nvar todayStr = (new Date(Date.now() - tzOffset)).toISOString().split('T')[0];\n\nif (rows && rows.length > 0) {\n    rows.forEach(function(r) {\n        var dayTotal = r.vao + r.ra;\n        totalVaoTuan += r.vao;\n        totalRaTuan += r.ra;\n        \n        if (r.d === todayStr) {\n            totalVaoHomNay = r.vao;\n            totalRaHomNay = r.ra;\n        }\n        \n        if (dayTotal > maxTotal) {\n            maxTotal = dayTotal;\n            maxDay = r.d;\n        }\n        \n        if (dayTotal < minTotal && dayTotal >= 0) {\n            minTotal = dayTotal;\n            minDay = r.d;\n        }\n    });\n}\n\nfunction formatDay(dateStr) {\n    if (!dateStr) return 'Chưa có';\n    var p = dateStr.split('-');\n    if (p.length !== 3) return dateStr;\n    return p[2] + '/' + p[1] + '/' + p[0];\n}\n\nvar html = `\n<div style=\"background:#fff; border:1px solid #c0c0c0; border-radius:8px; padding:20px; box-shadow:0 4px 10px rgba(0,0,0,0.1); font-family: 'Segoe UI', sans-serif;\">\n  <h3 style=\"color:#0056b3; font-weight:bold; margin-top:0; border-bottom:2px solid #0056b3; padding-bottom:10px;\">BÁO CÁO TỔNG HỢP (Tùy Chọn)</h3>\n  \n  <div style=\"display:flex; justify-content:space-between; gap:20px; margin-top:20px;\">\n    \n    <div style=\"flex:1; background:#f8f9fa; border-radius:6px; padding:15px; text-align:center; border:1px solid #ddd;\">\n      <h4 style=\"margin:0 0 10px 0; color:#555;\">HÔM NAY (${formatDay(todayStr)})</h4>\n      <div style=\"font-size:18px;\">\n        <span style=\"color:#28a745; font-weight:bold;\">Vào: ${totalVaoHomNay}</span> | \n        <span style=\"color:#0056b3; font-weight:bold;\">Ra: ${totalRaHomNay}</span>\n      </div>\n      <div style=\"font-size:24px; font-weight:bold; margin-top:10px;\">Tổng: ${totalVaoHomNay + totalRaHomNay}</div>\n    </div>\n    \n    <div style=\"flex:1; background:#e6f0ff; border-radius:6px; padding:15px; text-align:center; border:1px solid #b3d4ff;\">\n      <h4 style=\"margin:0 0 10px 0; color:#0056b3;\">TRONG KỲ BÁO CÁO</h4>\n      <div style=\"font-size:18px;\">\n        <span style=\"color:#28a745; font-weight:bold;\">Vào: ${totalVaoTuan}</span> | \n        <span style=\"color:#0056b3; font-weight:bold;\">Ra: ${totalRaTuan}</span>\n      </div>\n      <div style=\"font-size:24px; font-weight:bold; margin-top:10px; color:#0056b3;\">Tổng: ${totalVaoTuan + totalRaTuan}</div>\n    </div>\n    \n  </div>\n  \n  <div style=\"margin-top:20px; background:#fdfdfe; border-left:4px solid #ff9900; padding:10px 15px; border-radius:4px;\">\n    <div style=\"margin-bottom:8px;\"><strong>🔥 Ngày đông nhất:</strong> <span style=\"color:#ff6600;\">${formatDay(maxDay)}</span> (với <b>${maxTotal === -1 ? 0 : maxTotal}</b> lượt qua lại)</div>\n    <div><strong>🧊 Ngày vắng nhất:</strong> <span style=\"color:#17a2b8;\">${formatDay(minDay)}</span> (với <b>${minTotal === 9999999 ? 0 : minTotal}</b> lượt qua lại)</div>\n  </div>\n</div>\n`;\n\nmsg.payload = html;\nreturn msg;",
        "outputs": 1,
        "x": 820,
        "y": 700,
