        "format": "<div style=\"background-color: #ffffff; padding: 20px; border-radius: 8px; text-align: center; border: 1px solid #c0c0c0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; box-shadow: 0 4px 10px rgba(0,0,0,0.1);\">\n  <div style=\"display: flex; align-items: center; justify-content: center; margin-bottom: 20px; border-bottom: 2px solid #0056b3; padding-bottom: 10px;\">\n    <div style=\"flex: 1; text-align: left;\">\n      <h2 style=\"color: #0056b3; margin: 0; font-size: 20px; font-weight: bold;\">TRƯỜNG BÁCH KHOA</h2>\n      <h3 style=\"color: #333; margin: 5px 0 0 0; font-size: 16px;\">ĐẠI HỌC CẦN THƠ</h3>\n    </div>\n    <div style=\"flex: 1; text-align: right;\">\n      <h3 style=\"color: #ff6600; margin: 0; font-size: 18px; font-weight: bold;\">KHOA TỰ ĐỘNG HÓA</h3>\n    </div>\n  </div>\n  \n  <div ng-if=\"msg.payload.action == 'VAO'\" style=\"background-color: #e6f9e6; border: 2px solid #28a745; color: #28a745; padding: 30px; border-radius: 10px; margin-top: 15px; box-shadow: 0 0 15px rgba(40, 167, 69, 0.4);\">\n    <h1 style=\"margin: 0; font-size: 36px; font-weight: 900;\">&#10132; KHÁCH ĐANG VÀO</h1>\n    <p style=\"margin: 10px 0 0 0; font-size: 18px;\">Hệ thống ghi nhận luồng đi vào</p>\n  </div>\n  \n  <div ng-if=\"msg.payload.action == 'RA'\" style=\"background-color: #e6f0ff; border: 2px solid #0056b3; color: #0056b3; padding: 30px; border-radius: 10px; margin-top: 15px; box-shadow: 0 0 15px rgba(0, 86, 179, 0.4);\">\n    <h1 style=\"margin: 0; font-size: 36px; font-weight: 900;\">&#11013; KHÁCH ĐANG RA</h1>\n    <p style=\"margin: 10px 0 0 0; font-size: 18px;\">Hệ thống ghi nhận luồng đi ra</p>\n  </div>\n\n  <div ng-if=\"msg.payload.action == 'ALARM_STATIC'\" style=\"background-color: #ffe6e6; border: 3px solid #dc3545; color: #dc3545; padding: 30px; border-radius: 10px; margin-top: 15px; box-shadow: 0 0 20px rgba(220, 53, 69, 0.6); animation: blinker 1s linear infinite;\">\n    <h1 style=\"margin: 0; font-size: 36px; font-weight: 900;\">&#9888; CẢNH BÁO ĐỨNG IM</h1>\n    <p style=\"margin: 10px 0 0 0; font-size: 18px; font-weight: bold;\">Phát hiện vật cản ở khoảng cách {{msg.payload.distance}} cm!</p>\n  </div>\n  \n  <div ng-if=\"msg.payload.action != 'VAO' && msg.payload.action != 'RA' && msg.payload.action != 'ALARM_STATIC'\" style=\"background-color: #f8f9fa; border: 2px solid #6c757d; color: #6c757d; padding: 30px; border-radius: 10px; margin-top: 15px;\">\n    <h1 style=\"margin: 0; font-size: 36px; font-weight: 900;\">&#10003; SẴN SÀNG</h1>\n    <p style=\"margin: 10px 0 0 0; font-size: 18px;\">Khu vực kiểm soát đang trống</p>\n  </div>\n</div>\n\n<style>\n@keyframes blinker {\n  50% { opacity: 0.6; box-shadow: 0 0 10px rgba(220, 53, 69, 1); }\n}\n</style>",
