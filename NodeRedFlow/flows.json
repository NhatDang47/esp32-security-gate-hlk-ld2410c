    {
        "id": "03d68c3c2d9beb40",
        "type": "function",
        "z": "f2341ea2c16839d8",
        "name": "Format Data Grid",
        "func": "var rows = msg.payload;\nif (!rows || rows.length === 0) {\n  msg.payload = '<div style=\"padding:20px;color:#666;text-align:center;font-family:sans-serif;background:#f8f9fa;border:1px solid #ddd;border-radius:5px;\">Chưa có dữ liệu nhật ký</div>';\n  return msg;\n}\n\nvar html = '<div style=\"background:#fff; border:1px solid #ddd; border-radius:5px; padding:10px; font-family:sans-serif; max-height:280px; overflow-y:auto; box-shadow:0 2px 5px rgba(0,0,0,0.05);\">';\nhtml += '<table style=\"width:100%;border-collapse:collapse;font-size:14px;color:#333;\">';\nhtml += '<tr style=\"background:#0056b3;color:#fff;border-bottom:2px solid #004289;text-align:left;\">';\nhtml += '<th style=\"padding:10px\">ID</th><th style=\"padding:10px\">THỜI GIAN</th><th style=\"padding:10px\">SỰ KIỆN</th><th style=\"padding:10px;text-align:center;\">KHOẢNG CÁCH</th><th style=\"padding:10px;text-align:center;\">NĂNG LƯỢNG</th></tr>';\n\nrows.forEach(function(r) {\n  var evtColor = r.action === 'ALARM_STATIC' ? '#dc3545' : (r.action === 'VAO' ? '#28a745' : '#0056b3');\n  var evtText = r.action === 'ALARM_STATIC' ? 'CẢNH BÁO ĐỨNG IM' : (r.action === 'VAO' ? 'KHÁCH VÀO' : (r.action === 'RA' ? 'KHÁCH RA' : r.action));\n  \n  html += '<tr style=\"border-bottom:1px solid #eee; transition: background 0.2s;\" onmouseover=\"this.style.background=\\'#f4f6f9\\'\" onmouseout=\"this.style.background=\\'transparent\\'\">';\n  html += '<td style=\"padding:10px;color:#666;\">#' + r.id + '</td>';\n  html += '<td style=\"padding:10px;color:#555;\">' + r.time + '</td>';\n  html += '<td style=\"padding:10px;color:' + evtColor + ';font-weight:bold;\">' + evtText + '</td>';\n  html += '<td style=\"padding:10px;text-align:center;\">' + r.distance + ' cm</td>';\n  html += '<td style=\"padding:10px;text-align:center;\">' + r.energy + ' %</td>';\n  html += '</tr>';\n});\nhtml += '</table></div>';\n\nmsg.payload = html;\nreturn msg;",
