        "z": "f2341ea2c16839d8",
        "name": "Build Report Query",
        "func": "var s = flow.get('repStart');\nvar e = flow.get('repEnd');\nif (msg.payload && typeof msg.payload === 'object' && msg.payload.start) {\n    s = msg.payload.start;\n    e = msg.payload.end;\n    flow.set('repStart', s);\n    flow.set('repEnd', e);\n}\nif (!s || !e) {\n    var tz = (new Date()).getTimezoneOffset() * 60000;\n    e = new Date(Date.now() - tz).toISOString().split('T')[0];\n    s = new Date(Date.now() - tz - 6*24*3600*1000).toISOString().split('T')[0];\n    flow.set('repStart', s);\n    flow.set('repEnd', e);\n}\nmsg.topic = \"SELECT date(time) as d, SUM(CASE WHEN action='VAO' THEN 1 ELSE 0 END) as vao, SUM(CASE WHEN action='RA' THEN 1 ELSE 0 END) as ra FROM security_logs WHERE date(time) >= '\" + s + \"' AND date(time) <= '\" + e + \"' GROUP BY d ORDER BY d ASC;\";\nmsg.payload = null;\nreturn msg;",
