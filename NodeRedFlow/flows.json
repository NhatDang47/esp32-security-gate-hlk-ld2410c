        "name": "Generate Bulk SQL",
        "func": "var queries = [];\nvar now = new Date();\nfor(var i=0; i<300; i++) {\n  var d = new Date(now.getTime() - Math.random() * 7 * 24 * 3600 * 1000);\n  var isVao = Math.random() > 0.45;\n  var act = isVao ? \"VAO\" : (Math.random() > 0.8 ? \"ALARM_STATIC\" : \"RA\");\n  \n  var tzOffset = d.getTimezoneOffset() * 60000;\n  var localISOTime = (new Date(d - tzOffset)).toISOString().replace('T', ' ').substring(0, 19);\n  \n  var dist = Math.floor(Math.random()*150) + 50;\n  var enrg = Math.floor(Math.random()*60) + 40;\n  \n  queries.push(\"('\" + localISOTime + \"', '\" + act + \"', \" + dist + \", \" + enrg + \")\");\n}\nmsg.topic = \"INSERT INTO security_logs (time, action, distance, energy) VALUES \" + queries.join(\",\");\nreturn msg;",
