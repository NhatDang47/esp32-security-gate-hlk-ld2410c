        "name": "Date Range Picker",
        "order": 1,
        "width": "12",
        "height": "2",
        "format": "<div style=\"display: flex; align-items: center; justify-content: center; gap: 15px; padding: 15px; background: #ffffff; border-radius: 8px; border: 1px solid #c0c0c0; box-shadow: 0 4px 10px rgba(0,0,0,0.1);\">\n  <label style=\"font-weight: bold; color: #0056b3; font-size: 16px;\">TỪ NGÀY:</label>\n  <input type=\"date\" id=\"repStart\" style=\"padding: 8px; border-radius: 6px; border: 2px solid #0056b3; outline: none; cursor: pointer;\">\n  <label style=\"font-weight: bold; color: #0056b3; font-size: 16px; margin-left: 20px;\">ĐẾN NGÀY:</label>\n  <input type=\"date\" id=\"repEnd\" style=\"padding: 8px; border-radius: 6px; border: 2px solid #0056b3; outline: none; cursor: pointer;\">\n</div>\n<script>\n(function(scope) {\n  setTimeout(function() {\n    var elS = document.getElementById('repStart');\n    var elE = document.getElementById('repEnd');\n    function onChange() {\n        if(elS.value && elE.value) {\n            scope.send({payload: {start: elS.value, end: elE.value}});\n        }\n    }\n    elS.addEventListener('change', onChange);\n    elE.addEventListener('change', onChange);\n    if(!elS.value || !elE.value) {\n      var tz = (new Date()).getTimezoneOffset() * 60000;\n      var today = new Date(Date.now() - tz).toISOString().split('T')[0];\n      var lastWeek = new Date(Date.now() - tz - 6*24*3600*1000).toISOString().split('T')[0];\n      elS.value = lastWeek;\n      elE.value = today;\n      scope.send({payload: {start: lastWeek, end: today}});\n    }\n  }, 500);\n})(scope);\n</script>",
