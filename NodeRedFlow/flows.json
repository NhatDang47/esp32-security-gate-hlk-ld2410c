        "id": "cebc5002d8f29c44",
        "type": "function",
        "z": "f2341ea2c16839d8",
        "name": "Build Hourly Query",
        "func": "var date = flow.get('chartDate');\nif (msg.payload && typeof msg.payload === 'string' && msg.payload.match(/^\\d{4}-\\d{2}-\\d{2}$/)) {\n    date = msg.payload;\n    flow.set('chartDate', date);\n}\nif (!date) {\n    var tzOffset = (new Date()).getTimezoneOffset() * 60000;\n    date = (new Date(Date.now() - tzOffset)).toISOString().split('T')[0];\n    flow.set('chartDate', date);\n}\nmsg.topic = \"SELECT strftime('%H', time) as h, SUM(CASE WHEN action='VAO' THEN 1 ELSE 0 END) as vao, SUM(CASE WHEN action='RA' THEN 1 ELSE 0 END) as ra FROM security_logs WHERE date(time) = '\" + date + \"' GROUP BY h ORDER BY h ASC\";\nmsg.payload = null;\nreturn msg;\n",
